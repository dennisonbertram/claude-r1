BY_NAME = {t[0]: t for t in TOOLS}


# ---------------------------------------------------------------- MCP over HTTP

def handle(msg):
    method, mid, params = msg.get("method"), msg.get("id"), msg.get("params") or {}
    if mid is None:                       # notification: nothing to answer
        return None
    if method == "initialize":
        result = {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                  "capabilities": {"tools": {}},
                  "serverInfo": {"name": "r1-android", "version": "1.0"},
                  "instructions": "Controls the Rabbit R1 Android device this session runs on. "
                                  "Look (ui_elements or screenshot) before you tap."}
    elif method == "ping":
        result = {}
    elif method == "tools/list":
        result = {"tools": [{"name": n, "description": d,
                             "inputSchema": {"type": "object", "properties": p, "required": r}}
                            for n, d, p, r, _ in TOOLS]}
    elif method == "tools/call":
        tool = BY_NAME.get(params.get("name"))
        if not tool:
            return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32602, "message": "unknown tool"}}
        try:
            content, is_error = tool[4](params.get("arguments") or {})
        except Exception as e:            # report tool failures to Claude instead of crashing
            content, is_error = text(f"{type(e).__name__}: {e}"), True
        result = {"content": content, "isError": is_error}
    else:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"no method {method}"}}
    return {"jsonrpc": "2.0", "id": mid, "result": result}


class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body=None, headers=()):
        data = json.dumps(body).encode() if body is not None else b""
        self.send_response(code)
        for k, v in headers:
            self.send_header(k, v)
        if body is not None:
            self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        if self.path.rstrip("/") != "/mcp":
            return self._send(404)
        if self.headers.get("Authorization") != f"Bearer {TOKEN}":
            return self._send(401, {"error": "unauthorized"})
        msg = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        replies = [r for r in map(handle, msg if isinstance(msg, list) else [msg]) if r]
        if not replies:
            return self._send(202)
        self._send(200, replies if isinstance(msg, list) else replies[0],
                   [("Mcp-Session-Id", self.headers.get("Mcp-Session-Id") or SESSION)])

    def do_GET(self):
        self._send(405)

    def do_DELETE(self):
        self._send(200, {})

    def log_message(self, *a):
        pass


TOKEN, SESSION = token(), uuid.uuid4().hex

if __name__ == "__main__":
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
