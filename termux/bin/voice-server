#!/data/data/com.termux/files/usr/bin/python3
"""Voice agent backend for the Claude R1 launcher (serves the UI on 127.0.0.1:8765).

Tap → record (PulseAudio) → transcribe (ElevenLabs Scribe, whisper.cpp fallback) → one
long-lived Claude Code session with the Android tools → speak (ElevenLabs, espeak fallback).
New camera photos are sent into the same conversation as soon as they are saved.
"""
import array, base64, json, math, os, queue, re, shutil, signal, socket, struct, subprocess, sys, threading, time
import urllib.error, urllib.request, uuid, wave
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST, PORT = "127.0.0.1", 8765
PREFIX = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config/r1")
UI_DIR = os.path.join(PREFIX, "share/r1/voice-ui")
TMP = os.path.join(PREFIX, "tmp/r1")
PHOTO_DIR = os.path.join(TMP, "photos")
CAMERA_DIR = "/sdcard/DCIM/Camera"
RAW = os.path.join(TMP, "voice.wav")
RATE = 16000
WHISPER = os.path.join(HOME, "whisper.cpp/build/bin/whisper-cli")
WHISPER_MODEL = os.path.join(HOME, "whisper.cpp/models/ggml-base.en.bin")
EL_API = "https://api.elevenlabs.io/v1"

SYSTEM = """You are Claude, the voice assistant that is the whole interface of this Rabbit R1, a small \
handheld Android device. The user holds the side button and talks to you, usually while out and about; \
their words come from speech recognition and may contain errors, so read them for what they most likely \
meant. Your reply is spoken aloud and shown in large type on a 480x640 screen.

BE PROACTIVE AND HELPFUL
- Act, don't ask. Pick the sensible default and do it: the user's home area for weather and places, today \
for dates, the most likely match for a name, the latest episode of a show. Ask a short question only when a \
wrong guess would be costly or the request is genuinely ambiguous.
- Use your tools freely and chain them; do the research yourself rather than telling the user where to look.
- Anticipate the one thing they will need next and include it: rain means an umbrella, a delayed flight \
means the new time and gate, a long podcast means how long it runs.
- When it is clearly useful, end with one short offer for the obvious next step ("Want me to play it?"). \
Not on every turn.
- Use what was said earlier in the conversation; don't make them repeat themselves.
- If something fails, try another way before giving up. If you can't find live data, say so in one short \
sentence and give what you do know; don't send them to other apps or websites.

HOW TO SPEAK
- At most 40 words, in plain conversational sentences: no markdown, lists, code blocks or emoji.
- Give your single best answer; don't talk about sources disagreeing or where the data came from unless asked. \
Never end with warnings, caveats or advice to check again or double-check; give the answer and stop. 
- Never read error messages, URLs or IDs aloud.

CARDS
The screen can show cards: whenever you answer about weather, a flight, a stock or market index, a list of \
things (results, steps, events, scores, emails, notifications), the device's battery or status, or one key \
number or time, call show_card with that data before your final reply, even if the data is approximate. \
Then speak one or two sentences that summarise it rather than reading every value.

WHAT YOU CAN DO
- The device: see and control it with the android tools (screenshot, ui_elements, tap, swipe, type_text, \
press_key, open_app, notifications, device_status...). After doing something in another app, press home so \
the user comes back to you, unless they asked to look at it; then tell them holding the side button brings \
them back. If they ask to go back or go home, press home right away.
- Photos: when the user asks you to take a picture or to look at something, call take_photo right away; \
never tell them to press a button. When a message says they just took a photo, reply with one short \
sentence about what it shows.
- The web: search and read pages yourself (WebSearch, WebFetch) and answer here. Use open_url only when the \
user wants to see a page (directions: https://www.google.com/maps/dir/?api=1&destination=PLACE).
- Listening: podcasts (search_podcasts, podcast_episodes, play_audio), radio and music by station or genre \
(search_radio, play_audio), playback (media_control: pause, resume, skip, volume; it also controls other music \
apps). Playback pauses by itself while the user talks to you. After starting something, reply in a few words.
- Bluetooth headphones and speakers: bluetooth (status, on, off, pair).
- Email: if the Gmail tools (search_threads, get_thread, create_draft) are available, use them; otherwise use \
email_inbox, email_search, email_read and email_draft (the user's mail account set up on the R1). If neither \
works, say email isn't connected yet and that it can be set up from the computer. You can read mail and write \
drafts but never send, delete or archive: if asked to send, write the draft and say it's waiting in Drafts. \
For an inbox overview, show a list card of senders and subjects.
- Your voice: change it with list_voices and set_voice when asked.
- Your body: the context note says how the R1 is being held and whether it's moving (device_motion gives \
detail). Let it shape your answers: someone walking wants it shorter; lying face down on a table means they \
put you down. vibrate gives a tap, a double nudge, a long buzz or an alert; use it sparingly, e.g. to confirm \
something done or when the user asks.

MEMORY AND CONTEXT
- You have a memory that lasts across conversations. Whenever the user tells you something lasting about \
themselves (their name, people in their life, where they live and work, routines, likes and dislikes, plans, \
or anything they ask you to remember), save it with remember right away, without asking and without making a \
fuss about it. If a fact changes, forget the old one and remember the new one. Use recall to refresh what you \
know when it might help. Use what you know naturally, the way a friend would.
- Each message starts with a note of the current date, time and the user's location. Use it for anything \
time- or place-sensitive and never ask the user for the date, time or where they are.

THE DEVICE
- One side button: hold it to talk, double-press it for the camera.
- Holding a finger on the screen opens a menu with Start over (which forgets this conversation), Apps and \
Settings. When the user asks how to start over, reset, start a new conversation, or reach apps or settings, \
tell them: hold a finger on the screen, then tap Start over twice (or Apps, or Settings). Don't mention the \
menu otherwise.
- If an android tool fails because phone controls are off, say that phone controls are off and can be turned \
back on from the clock screen.

LIMITS
You are a voice assistant, not a coding agent: never look for, read or edit source code, and if the user asks \
to change this app itself, say briefly that it has to be done from their computer."""


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, file=sys.stderr, flush=True)


def read_conf(name, default=None):
    try:
        return open(os.path.join(CONF, name)).read().strip()
    except OSError:
        return default


VOICE_ID = read_conf("voice_id", "JBFqnCBsd6RMkjVDRZzb")
HOME_AREA = read_conf("home_location")          # e.g. "Brooklyn, New York": the default place for weather etc.
MEMORY_FILE = os.path.join(CONF, "memory.json")


def system_prompt():
    """SYSTEM plus the user's home area and remembered facts, read fresh whenever Claude starts."""
    extra = f"\n\nThe user's home area is {HOME_AREA}." if HOME_AREA else ""
    try:
        facts = [f["fact"] for f in json.load(open(MEMORY_FILE))]
    except (OSError, ValueError, KeyError, TypeError):
        facts = []
    if facts:
        extra += "\n\nWHAT YOU KNOW ABOUT THE USER (from earlier conversations)\n" + "\n".join("- " + f for f in facts)
    return SYSTEM + extra
TTS_MODEL = read_conf("tts_model", "eleven_flash_v2_5")
CLAUDE_MODEL = read_conf("claude_model", "claude-haiku-5-5")


# ---------------------------------------------------------------- shared state + SSE

REPLY_RULES = ("[Reply rules for this turn: if the answer is weather, a flight, a stock, a list, scores, "
               "a time or one key number, call show_card first, even if you showed the same thing earlier. "
               "No caveats or advice to double-check.]")


def with_rules(content):
    """Per-turn context note and reminder around text turns; photo turns (lists) pass through unchanged."""
    return f"[{context_note()}]\n" + content + "\n\n" + REPLY_RULES if isinstance(content, str) else content


SENSORS = {}     # the launcher's latest motion reading: posture, motion, gravity, movement, at


def context_note():
    note = f"Now: {time.strftime('%A, %B %-d, %Y, %-I:%M %p %Z')}; location: {LOCATION.describe()}"
    if SENSORS and time.time() - SENSORS.get("at", 0) < 120:
        note += f"; the R1 is {SENSORS['posture']}, {SENSORS['motion']}"
    return note


class Location:
    """Where the R1 is: a recent GPS fix if Android has one, else the city of its internet connection
    (ipinfo.io), else the configured home area. Refreshed in the background every 15 minutes."""

    def __init__(self):
        self.text, self.at = "", 0.0

    def describe(self):
        return self.text or (f"{HOME_AREA} (home area)" if HOME_AREA else "unknown")

    def refresh(self):
        gps = run(["timeout", "10", "rish", "-c", "dumpsys location | grep -m1 -o 'last location=Location\\[gps [-0-9.,]*'"]).stdout
        m = re.search(r"gps (-?[0-9.]+),(-?[0-9.]+)", gps)
        if m:
            self.text = f"GPS {m.group(1)}, {m.group(2)}" + (f" (home area: {HOME_AREA})" if HOME_AREA else "")
        else:
            try:
                req = urllib.request.Request("https://ipinfo.io/json", headers={"User-Agent": "claude-r1/1.0"})
                with urllib.request.urlopen(req, timeout=8) as r:
                    ip = json.load(r)
                self.text = f"around {ip.get('city')}, {ip.get('region')} (from the network)" + \
                    (f"; home area: {HOME_AREA}" if HOME_AREA else "")
            except (OSError, ValueError):
                pass
        self.at = time.time()


LOCATION = Location()


class Hub:
    """Current UI state, pushed to every connected page as server-sent events."""

    def __init__(self):
        self.lock = threading.Lock()
        # `boot` changes on every restart, telling open pages to reload (and pick up new UI code)
        self.state = {"state": "ready", "you": "", "reply": "", "tool": "", "photo": "", "error": "", "card": None,
                      "notice": "", "media": None, "ptt": False, "auto": False, "warming": False, "retry": False, "controls": False, "online": True,
                      "boot": uuid.uuid4().hex}
        self.clients = []

    def set(self, **kw):
        if kw.get("notice"):
            kw["notice_id"] = uuid.uuid4().hex[:8]      # the same words can come up twice in a row
        with self.lock:
            self.state.update(kw, now=time.time())
            msg = ("state", json.dumps(self.state))
            for q in self.clients:
                q.put(msg)

    def levels(self, lv):
        for q in list(self.clients):
            q.put(("level", json.dumps(lv)))

    def subscribe(self):
        q = queue.Queue()
        with self.lock:
            self.clients.append(q)
            q.put(("state", json.dumps(self.state)))
        return q

    def unsubscribe(self, q):
        with self.lock:
            if q in self.clients:
                self.clients.remove(q)


HUB = Hub()


# ---------------------------------------------------------------- audio

def run(cmd, **kw):
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, **kw)


def ensure_services():
    if subprocess.run(["pulseaudio", "--check"]).returncode:
        run(["pulseaudio", "--start", "--load=module-sles-source", "--exit-idle-time=-1"])
    if run(["pgrep", "-f", "bin/android-mcp$"]).returncode:
        subprocess.Popen(["android-mcp"], stdout=subprocess.DEVNULL,
                         stderr=open(os.path.join(TMP, "android-mcp.log"), "a"), start_new_session=True)


class Recorder:
    def __init__(self):
        self.proc, self.thread, self.pcm, self.levels = None, None, bytearray(), []

    def recording(self):
        return self.proc is not None

    def spoke(self):
        """Whether anything louder than room noise (about -40 dB) was recorded."""
        return sum(1 for v in self.levels if v > 0.45) >= 4

    def start(self):
        self.pcm, self.levels = bytearray(), []
        self.proc = subprocess.Popen(["parec", f"--rate={RATE}", "--channels=1", "--format=s16le",
                                      "--latency-msec=40"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.thread = threading.Thread(target=self._pump, daemon=True)
        self.thread.start()

    def _pump(self):
        step, pending, batch = RATE // 20 * 2, b"", []      # one level per 50ms of audio
        for chunk in iter(lambda: self.proc.stdout.read1(4096), b""):
            self.pcm += chunk
            pending += chunk
            while len(pending) >= step:
                s = array.array("h", pending[:step])
                pending = pending[step:]
                rms = math.sqrt(sum(x * x for x in s) / len(s)) / 32768
                db = 20 * math.log10(rms) if rms > 0 else -90
                batch.append(round(min(1.0, max(0.0, (db + 60) / 45)), 3))   # -60..-15 dB → 0..1
                self.levels.append(batch[-1])
                if len(batch) >= 2:
                    HUB.levels(batch)
                    batch = []

    def stop(self):
        if self.proc:
            self.proc.terminate()
            self.proc.wait()
            self.thread.join(2)
            self.proc = None
        with wave.open(RAW, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(bytes(self.pcm))
        return len(self.pcm) / (RATE * 2)


def el_key():
    return read_conf("elevenlabs_key")


class Offline(Exception):
    pass


def online():
    try:
        socket.getaddrinfo("api.anthropic.com", 443)
        return True
    except OSError:
        return False


OFFLINE_NOTICE = "No internet connection."   # short enough for the status pill


def still_offline():
    """The UI says offline: re-check for up to 1.5s before refusing (never call with Agent.lock held)."""
    if HUB.state.get("online") is not False:
        return False
    result = []
    t = threading.Thread(target=lambda: result.append(online()), daemon=True)
    t.start()
    t.join(1.5)
    if result and result[0]:
        HUB.set(online=True)
        return False
    return True


def watch_network():
    """Keep `online` in the UI state, so the status row can say Offline before anyone asks; refresh where we are."""
    while True:
        if ADB_WIFI["on"] and BUTTON.alive:
            # it came on while Shizuku was down (boot, or the user restarting Shizuku): off 20s after Shizuku is up.
            # It came on while Shizuku was running: probably on purpose (pairing), so leave it a few minutes.
            grace = 180 if ADB_WIFI["shizuku_up"] else 20
            if time.time() - max(ADB_WIFI["since"], BUTTON.alive_since) > grace:
                ADB_WIFI["on"] = False
                threading.Thread(target=close_wireless_adb, daemon=True).start()
        if time.time() - LOCATION.at > 900:
            threading.Thread(target=LOCATION.refresh, daemon=True).start()
        up = online()
        if HUB.state.get("online") != up:
            HUB.set(online=up)
        time.sleep(10)


def transcribe(path):
    if not online():
        raise Offline()
    key = el_key()
    if key:
        try:
            boundary = uuid.uuid4().hex
            parts = []
            for name, value in (("model_id", "scribe_v2"), ("language_code", "en"), ("tag_audio_events", "false")):
                parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{value}\r\n'.encode())
            parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="voice.wav"\r\n'
                         f'Content-Type: audio/wav\r\n\r\n'.encode() + open(path, "rb").read() + b"\r\n")
            parts.append(f"--{boundary}--\r\n".encode())
            req = urllib.request.Request(f"{EL_API}/speech-to-text", data=b"".join(parts), method="POST", headers={
                "xi-api-key": key, "Content-Type": f"multipart/form-data; boundary={boundary}"})
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r).get("text", "").strip()
        except Exception as e:
            log("scribe failed, using whisper:", e)
    if not os.path.exists(WHISPER):
        log("no ElevenLabs key and no whisper.cpp: can't transcribe")
        return ""
    wav = os.path.join(TMP, "voice-norm.wav")
    run(["sox", path, wav, "highpass", "100", "gain", "-n", "-3"])
    r = run([WHISPER, "-m", WHISPER_MODEL, "-f", wav, "-t", "6", "-nt", "-np"])
    return re.sub(r"\[[^\]]*\]|\([^)]*\)", "", " ".join(r.stdout.split())).strip()


class Speaker:
    """ElevenLabs streamed PCM into paplay, so speech starts ~0.3s after the request."""

    def __init__(self):
        self.lock, self.player, self.resp = threading.Lock(), None, None
        self.gen, self.pending = 0, False       # gen invalidates a say() that has not started playing yet

    def speaking(self):
        return self.pending or (self.player is not None and self.player.poll() is None)

    def _kill(self):
        """Stop the player and close the response (lock held)."""
        if self.player and self.player.poll() is None:
            try:
                os.killpg(self.player.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                self.player.kill()
        if self.resp:
            try:
                self.resp.close()
            except Exception:
                pass
        self.player, self.resp = None, None

    def claim(self):
        """Take over the speaker before a reply is published as "speaking"; returns the token for say()."""
        with self.lock:
            self._kill()
            self.gen += 1
            self.pending = True
            return self.gen

    def say(self, text, token=None):
        if token is None:
            token = self.claim()
        try:
            text = re.sub(r"[*_`#>|]", "", text).strip()
            if not text:
                return
            resp = None
            try:
                key = el_key()
                if not key:
                    raise RuntimeError("no ElevenLabs key")
                req = urllib.request.Request(
                    f"{EL_API}/text-to-speech/{read_conf('voice_id', VOICE_ID)}/stream?output_format=pcm_16000", method="POST",
                    data=json.dumps({"text": text, "model_id": TTS_MODEL}).encode(),
                    headers={"xi-api-key": key, "Content-Type": "application/json"})
                resp = urllib.request.urlopen(req, timeout=20)
            except Exception as e:
                log("elevenlabs failed, using espeak:", e)
            if resp is None:
                with self.lock:
                    if token != self.gen:
                        return
                    self.player = subprocess.Popen(["bash", "-c", 'espeak -s 165 --stdout "$1" | paplay', "_", text],
                                                   start_new_session=True, stderr=subprocess.DEVNULL)
                    player = self.player
                player.wait()
                return
            try:
                with self.lock:
                    if token != self.gen:
                        resp.close()
                        return
                    self.resp = resp
                    self.player = subprocess.Popen(["paplay", "--raw", f"--rate={RATE}", "--channels=1",
                                                    "--format=s16le"], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
                    player = self.player
                for chunk in iter(lambda: resp.read(4096), b""):
                    if player.poll() is not None:
                        break
                    player.stdin.write(chunk)
                try:
                    player.stdin.close()
                except OSError:
                    pass
                player.wait()
            except (BrokenPipeError, ValueError, OSError):
                pass                                # stopped mid-sentence
        finally:
            with self.lock:
                if token == self.gen:
                    self.pending = False

    def stop(self):
        with self.lock:
            self.gen += 1
            self.pending = False
            self._kill()


# ---------------------------------------------------------------- media player

class Player:
    """Podcasts, radio and music through mpv, controlled over its IPC socket. It pauses itself while
    the user talks to Claude ("ducked") and resumes once the answer has been spoken. A play request
    that arrives during a turn waits for the answer, so the music doesn't start over Claude's voice."""
    SOCK = os.path.join(TMP, "mpv.sock")

    def __init__(self):
        self.proc, self.title, self.kind = None, "", ""
        self.ducked, self.pending, self.lock = False, None, threading.Lock()

    def active(self):
        return self.proc is not None and self.proc.poll() is None

    def _ipc(self, *command):
        try:
            with socket.socket(socket.AF_UNIX) as c:
                c.settimeout(2)
                c.connect(self.SOCK)
                c.sendall(json.dumps({"command": list(command)}).encode() + b"\n")
                return json.loads(c.makefile().readline() or "{}")
        except (OSError, ValueError):
            return {}

    def _publish(self):
        playing = self.active() and not self._ipc("get_property", "pause").get("data", False)
        HUB.set(media={"title": self.title, "kind": self.kind, "playing": playing} if self.active() else None)

    def play(self, url, title, kind, busy):
        with self.lock:
            if busy:                          # mid-turn: start once the answer has been spoken
                self.pending = (url, title, kind)
                return "Queued; it starts when you finish answering."
            self._start(url, title, kind)
        return f"Playing {title or url}."

    def _start(self, url, title, kind):
        self._kill()
        self.title, self.kind, self.ducked, self.pending = title, kind, False, None
        self.proc = subprocess.Popen(["mpv", "--no-video", "--ao=pulse", "--really-quiet", "--volume=70",
                                      f"--input-ipc-server={self.SOCK}", url],
                                     stdout=subprocess.DEVNULL, stderr=open(os.path.join(TMP, "mpv.log"), "a"),
                                     start_new_session=True)
        threading.Thread(target=self._watch, args=(self.proc,), daemon=True).start()
        time.sleep(0.5)
        self._publish()

    def _watch(self, proc):
        proc.wait()
        if proc is self.proc:                 # finished or failed by itself
            self.proc = None
            HUB.set(media=None)

    def _kill(self):
        if self.active():
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        self.proc = None

    def duck(self):
        with self.lock:
            if self.active() and not self._ipc("get_property", "pause").get("data", True):
                self._ipc("set_property", "pause", True)
                self.ducked = True

    def unduck(self):
        with self.lock:
            if self.pending:
                self._start(*self.pending)
                return
            if self.ducked and self.active():
                self._ipc("set_property", "pause", False)
            self.ducked = False
        self._publish()

    def control(self, action, value=None):
        with self.lock:
            if not self.active() and action != "status":
                return False, "Nothing is playing here."
            if action == "pause":
                self._ipc("set_property", "pause", True)
                self.ducked = False           # the user paused it: don't resume after the answer
            elif action == "resume":
                self._ipc("set_property", "pause", False)
                self.ducked = False
            elif action == "stop":
                self._kill()
                self.ducked = self.pending = False
                HUB.set(media=None)
                return True, "Stopped."
            elif action in ("skip_forward", "skip_back"):
                secs = int(value or 30) * (1 if action == "skip_forward" else -1)
                self._ipc("seek", secs, "relative")
            elif action == "volume":
                self._ipc("set_property", "volume", max(0, min(100, int(value if value is not None else 70))))
            elif action == "status":
                if not self.active():
                    return True, "Nothing is playing."
                pos = self._ipc("get_property", "time-pos").get("data") or 0
                return True, f"{'Paused' if self._ipc('get_property', 'pause').get('data') else 'Playing'}: " \
                             f"{self.title} ({self.kind}), {int(pos) // 60} min in."
            else:
                return False, f"Can't {action} here."
        self._publish()
        return True, "Done."


PLAYER = Player()


