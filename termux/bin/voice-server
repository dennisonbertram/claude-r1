               "forget": "Forgetting that", "bluetooth": "Checking Bluetooth",
               "search_podcasts": "Finding podcasts", "podcast_episodes": "Getting episodes",
               "search_radio": "Finding stations", "play_audio": "Starting playback", "media_control": "Adjusting playback",
               "search_threads": "Checking your email", "get_thread": "Reading an email", "get_message": "Reading an email",
               "create_draft": "Drafting an email", "email_inbox": "Checking your email", "email_search": "Searching your email",
               "email_read": "Reading an email", "email_draft": "Drafting an email", "set_voice": "Changing my voice",
               "open_url": "Opening the page"}


# Gmail comes from the claude.ai connector of the account Claude Code is logged into: reading and drafts
# only (no send/delete). Other claude.ai connectors stay out of the voice session to keep it fast.
GMAIL_TOOLS = ",".join("mcp__claude_ai_Gmail__" + t for t in
                       ("search_threads", "get_thread", "get_message", "list_labels", "list_drafts", "get_draft",
                        "create_draft"))
OTHER_CONNECTORS = ",".join(("mcp__claude_ai_Google_Drive", "mcp__claude_ai_Google_Calendar", "mcp__claude_ai_Claude_Docs"))


class Claude:
    """One long-lived `claude -p` over stream-json: start-up under proot costs ~12s on the R1."""

    def __init__(self):
        self.proc, self.lock, self.warm = None, threading.Lock(), False

    def cold(self):
        """True until the current process has answered once (start-up under proot is ~12s)."""
        return not (self.warm and self.proc and self.proc.poll() is None)

    def start(self, fresh=False):
        if self.proc and self.proc.poll() is None:
            return
        self.warm = False
        cont = "" if fresh else "--continue "
        script = ("mkdir -p /root/voice && cd /root/voice && exec claude -p " + cont +
                  "--verbose --input-format stream-json --output-format stream-json "
                  "--model " + CLAUDE_MODEL + " --allowedTools=mcp__android,WebSearch,WebFetch," + GMAIL_TOOLS +
                  " --disallowedTools=" + OTHER_CONNECTORS + " --append-system-prompt \"$1\"")
        self.proc = subprocess.Popen(
            ["proot-distro", "login", "debian", "--shared-tmp", "--",
             "env", "PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin",
             "DISABLE_AUTOUPDATER=1", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1",
             # load every tool's schema up front: there are few, and Haiku won't go looking for
             # deferred ones (show_card went unused); the claude.ai connectors aren't approved here
             "ENABLE_TOOL_SEARCH=false",
             "bash", "-c", script, "_", system_prompt()],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=open(os.path.join(TMP, "claude.log"), "a"),
            text=True, bufsize=1, start_new_session=True)

    def restart(self, fresh=False):
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        self.proc = None
        self.start(fresh)

    def interrupt(self):
        """Ask Claude Code to stop the current turn (it still emits a result we then ignore)."""
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.stdin.write(json.dumps({"type": "control_request", "request_id": uuid.uuid4().hex,
                                                  "request": {"subtype": "interrupt"}}) + "\n")
                self.proc.stdin.flush()
            except OSError:
                pass

    def ask(self, content, on_tool=None):
        with self.lock:
            self.start()
            try:
                self.proc.stdin.write(json.dumps({"type": "user", "message": {"role": "user", "content": content}}) + "\n")
                self.proc.stdin.flush()
                for line in self.proc.stdout:
                    try:
                        ev = json.loads(line)
                    except ValueError:
                        continue
                    if ev.get("type") == "assistant" and on_tool:
                        for block in ev.get("message", {}).get("content", []):
                            if block.get("type") == "tool_use":
                                name = block.get("name", "").split("__")[-1]
                                label = TOOL_LABELS.get(name, "Working")
                                on_tool(label.format(**{k: str(v).split(".")[-1] for k, v in
                                                        (block.get("input") or {}).items()}) + "…")
                    if ev.get("type") == "result":
                        self.warm = True
                        return plain(ev.get("result") or "").strip() or "Done."
            except (BrokenPipeError, OSError) as e:
                log("claude pipe:", e)
            self.proc = None
            return "Claude stopped unexpectedly. Ask again to restart it."


def plain(text):
    text = re.sub(r"\*\*|__|`+|^#+\s*", "", text, flags=re.M)
    return re.sub(r"^\s*[-*]\s+", "• ", text, flags=re.M)


# ---------------------------------------------------------------- the agent

GO_BACK = re.compile(r"^\W*(please\W+)?(take me |go |bring me |get me )?(back|home)( home)?( to (claude|you|the (voice|home) screen))?"
                     r"( please)?\W*$", re.I)
# questions about the app itself get a fixed answer: no need to ask Claude (whose history may disagree)
HOW_START_OVER = re.compile(r"\b(how (do|can) i|how to|can i|can you|i want to|let'?s)\b.*\b(start over|start fresh|"
                            r"start again|reset( (you|this|our|the) (conversation|chat))?|clear (this|our|the) "
                            r"(conversation|chat)|(a )?new (conversation|chat)|forget (this|our|the) conversation|"
                            r"forget everything)\W*$", re.I)
START_OVER_HELP = "Hold a finger on the screen, then tap Start over twice. That starts a fresh conversation."
VIEW_KEYS = ("state", "you", "reply", "photo", "card", "error")
TURN_TIMEOUT_S = 45


class Agent:
    """The conversation loop. `turn` identifies the Claude request whose result may be shown;
    `rec_id` the recording. A hold or tap only interrupts Claude once real speech was recorded,
    so holding the button just to come back to Claude never loses what was on screen."""

    def __init__(self):
        self.rec, self.speaker, self.claude = Recorder(), Speaker(), Claude()
        self.lock = threading.Lock()
        self.turn = 0           # bumped whenever a Claude result should no longer be shown
        self.rec_id = 0         # bumped per recording
        self.ptt = None         # None | "pending" (button down) | "held" | "auto" (stops on silence)
        self.saved = None       # the view to put back if a recording turns out silent
        self.parked = None      # a reply that arrived while the user was holding to talk
        self.before = None      # the view before the current question, for cancel
        self.last_content = None

    # ---- listening

    def _listen(self, ptt):
        PLAYER.duck()
        if HUB.state["state"] != "listening":
            self.saved = {k: HUB.state[k] for k in VIEW_KEYS}
        if self.speaker.speaking():
            self.speaker.stop()
            if self.saved and self.saved["state"] == "speaking":
                self.saved["state"] = "answer"
        if not self.rec.recording():
            self.rec.start()
        self.rec_id += 1
        self.ptt = ptt
        HUB.set(state="listening", since=time.time(), notice="", ptt=bool(ptt), auto=ptt == "auto")
        return self.rec_id

    # push-to-talk on the side (power) button. Pressing starts the mic quietly so the first
    # syllable isn't lost; holding past HOLD_S makes it a talk; releasing sends it. A short
    # press (screen off, or the camera double-press) just throws the audio away.
    def ptt_press(self):
        with self.lock:
            if HUB.state["state"] == "listening" or self.rec.recording():
                return
            self.rec.start()
            self.ptt = "pending"

    def ptt_hold(self, autostop=False):
        with self.lock:
            log("ptt hold: autostop", autostop, "state", HUB.state["state"], "ptt", self.ptt)
            if HUB.state["state"] == "listening":
                return
            gated = HUB.state["state"] in ("ready", "answer")
        if gated and still_offline():           # ptt stays "pending": the release throws the audio away
            HUB.set(notice=OFFLINE_NOTICE)
            threading.Thread(target=self.speaker.say, args=("No internet connection.",), daemon=True).start()
            return
        with self.lock:
            if HUB.state["state"] == "listening" or (gated and HUB.state["state"] not in ("ready", "answer")):
                return
            rid = self._listen("auto" if autostop else "held")
        if autostop:
            threading.Thread(target=self._stop_on_silence, args=(rid,), daemon=True).start()

    def ptt_release(self):
        with self.lock:
            mode, self.ptt = self.ptt, None
            log("ptt release: mode", mode, "state", HUB.state["state"], "recording", self.rec.recording())
            if mode == "pending" and HUB.state["state"] != "listening":
                self.rec.stop()
                return
            if mode == "held" and HUB.state["state"] == "listening":
                threading.Thread(target=self._finish_recording, daemon=True).start()

    def assist(self):
        """The launcher was opened by a long press (Android's assistant action)."""
        log("assist: watcher alive", BUTTON.alive, "down", BUTTON.down)
        if not BUTTON.alive:
            self.ptt_hold(autostop=True)        # no release event coming: stop on silence
        elif BUTTON.down:
            self.ptt_hold()                     # the watcher's own hold timer usually got here first

    def _stop_on_silence(self, rid):
        """Without the button watcher there's no release event: stop after ~1.2s of quiet once
        speech began, or after 4s if nothing is said (then it was just a "take me back")."""
        start = time.time()
        while rid == self.rec_id and HUB.state["state"] == "listening" and time.time() - start < 30:
            time.sleep(0.2)
            lv = self.rec.levels
            if self.rec.spoke() and len(lv) > 24 and max(lv[-24:]) < 0.3:
                break
            if not self.rec.spoke() and time.time() - start > 4:
                break
        if rid == self.rec_id and HUB.state["state"] == "listening":
            self.talk()

    def talk(self):
        """A tap: start listening, or send what was recorded."""
        for checked in (False, True):
            with self.lock:
                st = HUB.state["state"]
                log("talk (tap): state", st, "ptt", self.ptt)
                if st == "listening":
                    self.ptt = None
                    threading.Thread(target=self._finish_recording, daemon=True).start()
                    return
                if st in ("transcribing", "thinking"):
                    return
                if checked or st not in ("ready", "answer"):
                    rid = self._listen(None)
                    break
            if still_offline():                 # outside the lock: the DNS lookup can block
                HUB.set(notice=OFFLINE_NOTICE)
                return
        threading.Thread(target=self._tap_limit, args=(rid,), daemon=True).start()

    def _tap_limit(self, rid):
        """A forgotten tap-to-talk (or a pocket tap) stops by itself."""
        time.sleep(60)
        if rid == self.rec_id and HUB.state["state"] == "listening":
            self.talk()

    def _finish_recording(self):
        with self.lock:
            if HUB.state["state"] != "listening":
                return log("finish: not listening any more")
            self.rec_id += 1
            secs = self.rec.stop()
            spoke = self.rec.spoke()
            log(f"finish: {secs:.1f}s, speech {spoke}")
            if secs < 1.0 or not spoke:
                return self._restore()
            # real speech: now the new question replaces whatever Claude was doing
            if self.saved["state"] in ("answer", "ready", "speaking"):
                self.before = dict(self.saved, state="answer")
            self.turn += 1
            turn = self.turn
            busy = self.saved and self.saved["state"] in ("transcribing", "thinking")
            if busy:
                self.claude.interrupt()
            self.parked, self.saved = None, None if not busy else self.saved
            HUB.set(state="transcribing", you="", tool="", ptt=False)
        try:
            text = transcribe(RAW)
        except Offline:
            if turn == self.turn:
                HUB.set(online=False)
                with self.lock:
                    self.saved = self.saved or self.before
                    self._restore(notice=OFFLINE_NOTICE)
            return
        if turn != self.turn:
            return
        if HOW_START_OVER.search(text):
            return self._local_reply(turn, text, START_OVER_HELP)
        if GO_BACK.match(text):                  # holding the button already brought Claude to the front
            with self.lock:
                self.saved = self.saved or self.before
                self._restore()
            return
        if not text:
            with self.lock:
                self.saved = self.saved or self.before
                self._restore(notice="Didn't catch that. Try again.")
            return
        self._respond(turn, text, text, photo="")

    def _restore(self, notice=""):
        """Put back the screen from before the recording (lock held)."""
        saved, self.saved = self.saved or {"state": "ready"}, None
        if saved["state"] not in ("transcribing", "thinking"):
            threading.Thread(target=PLAYER.unduck, daemon=True).start()
        if self.parked:                              # Claude finished while we were listening
            reply, self.parked = self.parked, None
            tok = self.speaker.claim()
            HUB.set(state="speaking", reply=reply, tool="", notice=notice, ptt=False)
            threading.Thread(target=self._speak, args=(self.turn, reply, tok), daemon=True).start()
            return
        if saved["state"] in ("transcribing", "thinking"):
            HUB.set(**saved, notice=notice, ptt=False)       # still working on it
            return
        state = "answer" if saved.get("reply") or saved.get("photo") or saved.get("error") else "ready"
        HUB.set(**dict(saved, state=state), notice=notice, ptt=False)

    # ---- answering

    def _respond(self, turn, shown, content, photo):
        self.before = {k: HUB.state[k] for k in VIEW_KEYS} if HUB.state["state"] in ("answer", "ready", "speaking") \
            else self.before
        self.last_content = (shown, content, photo)
        HUB.set(state="thinking", you=shown, reply="", photo=photo, tool="", card=None, error="",
                notice="", since=time.time(), warming=self.claude.cold())
        watchdog = threading.Timer(TURN_TIMEOUT_S, self._timeout, args=(turn,))
        watchdog.start()
        try:
            reply = self.claude.ask(with_rules(content), on_tool=lambda t: turn == self.turn and HUB.set(tool=t, warming=False))
        finally:
            watchdog.cancel()
        with self.lock:
            if turn != self.turn:
                return
            if HUB.state["state"] == "listening":     # he's holding to talk: show it if he stays silent
                self.parked = reply
                return
            tok = self.speaker.claim()
            HUB.set(state="speaking", reply=reply, tool="", warming=False)
        self._speak(turn, reply, tok)

    def _local_reply(self, turn, shown, reply):
        """Answer without Claude (fixed help text)."""
        with self.lock:
            if turn != self.turn:
                return
            token = self.speaker.claim()
            HUB.set(state="speaking", you=shown, reply=reply, photo="", card=None, error="", tool="")
        self._speak(turn, reply, token)

    def _speak(self, turn, reply, token):
        self.speaker.say(reply, token)
        if turn == self.turn and HUB.state["state"] == "speaking":
            HUB.set(state="answer")
            PLAYER.unduck()

    def _timeout(self, turn):
        """No answer in TURN_TIMEOUT_S: probably no connection. Stop waiting and offer a retry."""
        if turn != self.turn:
            return
        log("turn timed out")
        with self.lock:
            self.turn += 1
            HUB.set(state="answer", reply="", tool="", warming=False, retry=True,
                    error="No answer — the connection may be down. Tap to try again.")
        self.claude.interrupt()
        time.sleep(5)
        if self.claude.lock.locked():               # the interrupt didn't free it: start over
            self.claude.restart()

    def retry(self):
        if not self.last_content or HUB.state["state"] in ("listening", "transcribing", "thinking"):
            return
        if still_offline():
            HUB.set(notice=OFFLINE_NOTICE)
            return
        with self.lock:
            self.turn += 1
            turn = self.turn
        HUB.set(retry=False)
        self._respond(turn, *self.last_content)

    def stop_speaking(self):
        self.speaker.stop()
        HUB.set(state="answer")

    def cancel(self):
        with self.lock:
            self.turn += 1
            self.claude.interrupt()
            self.speaker.stop()
            prev = self.before or {}
            has = prev.get("reply") or prev.get("photo")
            HUB.set(**{k: prev.get(k, "" if k != "card" else None) for k in VIEW_KEYS if k != "state"},
                    state="answer" if has else "ready", tool="", warming=False)

    def new_conversation(self):
        self.cancel()
        self.claude.restart(fresh=True)
        self.before = self.last_content = None
        HUB.set(state="ready", you="", reply="", photo="", error="", card=None, retry=False, fresh=time.time())

    def photo_taken(self, src):
        """Shrink a new camera photo and hand it to Claude in the running conversation."""
        name = os.path.splitext(os.path.basename(src))[0] + ".jpg"
        thumb, full = os.path.join(PHOTO_DIR, "t_" + name), os.path.join(PHOTO_DIR, name)
        for dst, side, qv in ((thumb, 480, 5), (full, 1280, 4)):
            run(["ffmpeg", "-loglevel", "error", "-y", "-i", src, "-vf",
                 f"scale='min({side},iw)':'min({side},ih)':force_original_aspect_ratio=decrease", "-q:v", str(qv), dst])
        if not os.path.exists(full):
            return log("could not convert", src)
        with self.lock:
            if HUB.state["state"] in ("listening", "transcribing"):
                return log("photo arrived mid-question; Claude can still get it with recent_photos")
            self.turn += 1
            turn = self.turn
            self.speaker.stop()
        content = [{"type": "image", "source": {"type": "base64", "media_type": "image/jpeg",
                                                "data": base64.b64encode(open(full, "rb").read()).decode()}},
                   {"type": "text", "text": f"I just took this photo with the R1 camera (saved on the device "
                                            f"as {src}). In one short spoken sentence of at most 20 words, "
                                            f"tell me what it shows. No lists."}]
        self._respond(turn, "", content, photo="/photos/t_" + name)


AGENT = None


class Button:
    """Watch the side (power) button by reading its input devices raw, which needs the shell user
    (Shizuku's rish). rish's own stdout relay is slow and batches small writes, so the shell-side
    reader sends the events straight to us over a local socket instead:
    (echo TOKEN; cat /dev/input/eventN) | nc 127.0.0.1 8767.
    Android still handles the key itself: its long-press action is "assistant", which opens the
    launcher; this adds the press/release timing for push-to-talk."""
    HOLD_S = 0.4
    PORT = 8767
    DEVICES = ("/dev/input/event0", "/dev/input/event1")    # the R1's mtk-kpd and mtk-pmic-keys, if discovery fails
    EVENT = struct.Struct("<qqHHi")                          # struct input_event on arm64
    EV_KEY, KEY_POWER = 1, 116

    def __init__(self):
        self._alive = self.down = False
        self.alive_since = 0.0
        self.timer, self.retry_now = None, False
        self.lock = threading.Lock()
        self.token = uuid.uuid4().hex
        self.connected = 0

    @property
    def alive(self):
        return self._alive

    @alive.setter
    def alive(self, v):
        # the same Shizuku shell powers Claude's phone controls, so show it as "Phone controls"
        if v != self._alive:
            self._alive = v
            self.alive_since = time.time()
            HUB.set(controls=v)

    def run(self):
        srv = socket.socket()
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("127.0.0.1", self.PORT))
        srv.listen(4)
        threading.Thread(target=self._accept, args=(srv,), daemon=True).start()
        self._kill_readers()                 # a killed predecessor leaves its readers behind
        while True:
            procs = [subprocess.Popen(["rish", "-c", f"(echo {self.token}; exec cat {dev}) | nc 127.0.0.1 {self.PORT}"],
                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                     for dev in self._devices()]
            for p in procs:
                p.wait()                     # returns when Shizuku (or the reader) goes away
            self._kill_readers()
            self.alive = False
            for _ in range(20):              # Shizuku not running (it stops on reboot); try again
                if self.retry_now:
                    break
                time.sleep(1)
            self.retry_now = False

    def _devices(self):
        """Input devices that report the power key (numbering differs between Android builds)."""
        # via a file: rish's own stdout relay reorders long output
        tmp = "/sdcard/Download/.claude-r1-input-devices.txt"
        run(["timeout", "15", "rish", "-c", f"getevent -lp > {tmp}"])
        try:
            with open(tmp) as f:
                out = f.read()
            os.remove(tmp)
        except OSError:
            out = ""
        found = [blk.split("\n", 1)[0].split()[-1] for blk in out.split("add device")[1:] if "KEY_POWER" in blk]
        return found or list(self.DEVICES)

    def _kill_readers(self):
        for pid in run(["pgrep", "-f", "rish -c (exec getevent|exec cat /dev/input|\\(echo)"]).stdout.split():
            try:
                os.killpg(int(pid), signal.SIGKILL)
            except (ProcessLookupError, PermissionError, ValueError):
                pass

    def reconnect(self):
        """Drop the current readers so run() starts fresh ones right away."""
        self.retry_now = True
        self._kill_readers()

    def _accept(self, srv):
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=self._read, args=(conn,), daemon=True).start()

    def _read(self, conn):
        f = conn.makefile("rb", buffering=0)
        if f.readline().strip().decode(errors="replace") != self.token:
            return conn.close()              # not our reader
        with self.lock:
            self.connected += 1
        self.alive = True
        size = self.EVENT.size
        try:
            while True:
                data = f.read(size)
                while data and len(data) < size:
                    more = f.read(size - len(data))
                    if not more:
                        break
                    data += more
                if len(data) < size:
                    return
                _, _, typ, code, value = self.EVENT.unpack(data)
                if typ == self.EV_KEY and code == self.KEY_POWER and value in (0, 1):
                    self._key(value == 1)
        finally:
            conn.close()
            with self.lock:
                self.connected -= 1
                if not self.connected:
                    self.alive = False

    def _key(self, pressed):
        with self.lock:                      # both devices may report the same press
            if pressed == self.down:
                return
            self.down = pressed
        log("side button", "down" if pressed else "up")
        if pressed:
            AGENT.ptt_press()
            self.timer = threading.Timer(self.HOLD_S, AGENT.ptt_hold)
            self.timer.start()
        else:
            self.timer and self.timer.cancel()
            AGENT.ptt_release()


ADB_WIFI = {"on": False, "since": 0.0, "shizuku_up": False}   # reported by the launcher


def close_wireless_adb():
    """Shizuku's start-on-boot (no root) switches on wireless debugging to start itself and leaves it on.
    Once Shizuku is up it isn't needed, so turn it off: an open adb port on someone else's Wi-Fi is a risk,
    especially on builds where adb doesn't ask for authorization. Only right after boot, so turning wireless
    debugging on later on purpose (e.g. to pair Shizuku) isn't undone right away."""
    if run(["timeout", "10", "rish", "-c", "settings get global adb_wifi_enabled"]).stdout.strip() == "1":
        run(["timeout", "10", "rish", "-c", "settings put global adb_wifi_enabled 0"])
        log("turned wireless debugging off (Shizuku is running)")


BUTTON = Button()


last_photo = [0.0]


def bring_claude_forward(when):
    """After a photo, show Claude (with the photo and its caption) unless another shot followed."""
    if last_photo[0] != when or not BUTTON.alive:
        return
    subprocess.Popen(["rish", "-c", "am start -n ai.r1.claude/.MainActivity"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def watch_camera():
    """Poll the camera folder; a file counts as new once its size has stopped changing."""
    seen = set(os.listdir(CAMERA_DIR)) if os.path.isdir(CAMERA_DIR) else set()
    while True:
        time.sleep(1)
        try:
            names = set(os.listdir(CAMERA_DIR))
        except OSError:
            continue
        for n in sorted(names - seen):
            if not re.search(r"\.(jpe?g|png)$", n, re.I) or n.startswith("."):
                seen.add(n)
                continue
            p = os.path.join(CAMERA_DIR, n)
            size = -1
            for _ in range(20):
                s = os.path.getsize(p)
                if s == size and s > 0:
                    break
                size = s
                time.sleep(0.3)
            seen.add(n)
            log("new photo", n)
            last_photo[0] = time.time()
            threading.Thread(target=AGENT.photo_taken, args=(p,), daemon=True).start()
            threading.Timer(3, bring_claude_forward, args=(last_photo[0],)).start()


# ---------------------------------------------------------------- http

MIME = {".html": "text/html; charset=utf-8", ".js": "text/javascript", ".css": "text/css",
        ".woff2": "font/woff2", ".jpg": "image/jpeg", ".png": "image/png", ".svg": "image/svg+xml"}


class Handler(BaseHTTPRequestHandler):
    def _file(self, path):
        try:
            data = open(path, "rb").read()
        except OSError:
            return self.send_error(404)
        self.send_response(200)
        self.send_header("Content-Type", MIME.get(os.path.splitext(path)[1], "application/octet-stream"))
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/api/events":
            return self._events()
        if path == "/api/sensors":
            data = json.dumps(SENSORS).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            return self.wfile.write(data)
        if path.startswith("/photos/"):
            return self._file(os.path.join(PHOTO_DIR, os.path.basename(path)))
        rel = "index.html" if path == "/" else os.path.normpath(path.lstrip("/"))
        if rel.startswith(".."):
            return self.send_error(403)
        self._file(os.path.join(UI_DIR, rel))

    def do_POST(self):
        if self.path == "/api/fix":
            ok = run(["timeout", "10", "rish", "-c", "id"]).returncode == 0
            if ok:
                BUTTON.reconnect()
                run(["pkill", "-f", "bin/android-mcp$"])        # its shell reconnects on restart
                ensure_services()
            data = json.dumps({"ok": ok}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            return self.wfile.write(data)
        if self.path == "/api/media":
            try:
                cmd = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)))
            except ValueError:
                return self.send_error(400)
            if cmd.get("action") == "play":
                busy = HUB.state["state"] in ("listening", "transcribing", "thinking")
                ok, msg = True, PLAYER.play(cmd.get("url", ""), cmd.get("title", ""), cmd.get("kind", "audio"), busy)
            else:
                ok, msg = PLAYER.control(cmd.get("action", ""), cmd.get("value"))
            data = json.dumps({"ok": ok, "message": msg}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            return self.wfile.write(data)
        if self.path == "/api/adbwifi":
            try:
                on = bool(json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0))).get("on"))
            except ValueError:
                return self.send_error(400)
            if on and not ADB_WIFI["on"]:
                ADB_WIFI.update(on=True, since=time.time(), shizuku_up=BUTTON.alive)
            elif not on:
                ADB_WIFI["on"] = False
            self.send_response(204)
            return self.end_headers()
        if self.path == "/api/sensors":
            try:
                reading = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)))
            except ValueError:
                return self.send_error(400)
            SENSORS.clear()
            SENSORS.update(reading, at=time.time())
            self.send_response(204)
            return self.end_headers()
        if self.path == "/api/card":
            try:
                card = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)))
            except ValueError:
                return self.send_error(400)
            HUB.set(card=card)
            self.send_response(204)
            return self.end_headers()
        actions = {"/api/talk": AGENT.talk, "/api/cancel": AGENT.cancel, "/api/stop": AGENT.stop_speaking,
                   "/api/new": AGENT.new_conversation, "/api/assist": AGENT.assist, "/api/retry": AGENT.retry,
                   # the side button's press/hold/release, for testing without a finger on it
                   "/api/ptt/press": AGENT.ptt_press, "/api/ptt/hold": AGENT.ptt_hold,
                   "/api/ptt/release": AGENT.ptt_release}
        fn = actions.get(self.path)
        if not fn:
            return self.send_error(404)
        threading.Thread(target=fn, daemon=True).start()
        self.send_response(204)
        self.end_headers()

    def _events(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        q = HUB.subscribe()
        try:
            while True:
                try:
                    kind, data = q.get(timeout=15)
                    self.wfile.write(f"event: {kind}\ndata: {data}\n\n".encode())
                except queue.Empty:
                    self.wfile.write(b": ping\n\n")
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            HUB.unsubscribe(q)

    def log_message(self, *a):
        pass


def keep_services_alive():
    while True:
        time.sleep(30)
        ensure_services()


def main():
    global AGENT
    os.makedirs(PHOTO_DIR, exist_ok=True)
    try:
        server = ThreadingHTTPServer((HOST, PORT), Handler)   # bind first: a second copy exits here
    except OSError:
        sys.exit("voice-server is already running")
    ensure_services()
    AGENT = Agent()
    AGENT.claude.start()                    # boot Claude now so the first question doesn't wait
    threading.Thread(target=watch_camera, daemon=True).start()
    threading.Thread(target=BUTTON.run, daemon=True).start()
    threading.Thread(target=watch_network, daemon=True).start()
    threading.Thread(target=keep_services_alive, daemon=True).start()
    log(f"listening on http://{HOST}:{PORT}")
    server.serve_forever()


if __name__ == "__main__":
    main()
